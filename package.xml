<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="org.ros.package.format3.xsd"?>
<package format="3">
  <name>my_ros2_robot</name>
  <version>0.0.0</version>
  <description>Custom ROS 2 Jazzy Mecanum Robot Package</description>
  <maintainer email="user@todo.todo">bp_international</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>xacro</depend>
  <depend>robot_state_publisher</depend>
  <depend>ros_gz_sim</depend>
  <depend>ros_gz_bridge</depend>
  <depend>gz_ros2_control</depend>
  <depend>hardware_interface</depend>
  <depend>controller_manager</depend>
  <depend>mecanum_drive_controller</depend>
  <depend>joint_state_broadcaster</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
