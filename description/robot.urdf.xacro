<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="my_ros2_robot">
  <material name="deck_mat"><color rgba="0.16 0.17 0.18 1.0"/></material>
  <material name="frame_mat"><color rgba="0.10 0.11 0.12 1.0"/></material>
  <material name="wheel_mat"><color rgba="0.035 0.04 0.045 1.0"/></material>

  <xacro:include filename="../urdf/lidar.xacro"/>

  <!-- base_footprint is at ground level; the wheel axes are 30 mm above it. -->
  <link name="base_footprint"/>
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.03" rpy="0 0 0"/>
  </joint>

  <!-- Lower 4 mm deck and four slim stand-offs. -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.036" rpy="0 0 0"/>
      <geometry><box size="0.195 0.18 0.004"/></geometry>
      <material name="deck_mat"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.036" rpy="0 0 0"/>
      <geometry><box size="0.195 0.18 0.004"/></geometry>
    </collision>
    <visual><origin xyz="0.068 0.062 0.06"/><geometry><cylinder radius="0.004" length="0.044"/></geometry><material name="frame_mat"/></visual>
    <visual><origin xyz="0.068 -0.062 0.06"/><geometry><cylinder radius="0.004" length="0.044"/></geometry><material name="frame_mat"/></visual>
    <visual><origin xyz="-0.068 0.062 0.06"/><geometry><cylinder radius="0.004" length="0.044"/></geometry><material name="frame_mat"/></visual>
    <visual><origin xyz="-0.068 -0.062 0.06"/><geometry><cylinder radius="0.004" length="0.044"/></geometry><material name="frame_mat"/></visual>
    <inertial>
      <mass value="1.0"/>
      <origin xyz="0 0 0.036" rpy="0 0 0"/>
      <inertia ixx="0.00270" ixy="0" ixz="0" iyy="0.00317" iyz="0" izz="0.00537"/>
    </inertial>
  </link>

  <!-- Upper deck makes the two-level chassis shown in the reference photos.
       Its top is 116 mm above the floor, excluding the lidar. -->
  <link name="upper_deck">
    <visual>
      <geometry><box size="0.195 0.18 0.004"/></geometry>
      <material name="deck_mat"/>
    </visual>
    <collision><geometry><box size="0.195 0.18 0.004"/></geometry></collision>
    <inertial>
      <mass value="0.3"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.00081" ixy="0" ixz="0" iyy="0.00095" iyz="0" izz="0.00175"/>
    </inertial>
  </link>
  <joint name="upper_deck_joint" type="fixed">
    <parent link="base_link"/>
    <child link="upper_deck"/>
    <origin xyz="0 0 0.084" rpy="0 0 0"/>
  </joint>

  <!-- Lidar reference frame attached to the robot chassis. -->
  <link name="chassis"/>
  <joint name="chassis_mount_joint" type="fixed">
    <parent link="base_link"/>
    <child link="chassis"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Four 60 mm mecanum wheels; outer footprint is approximately 210 x 195 mm. -->
  <xacro:macro name="wheel" params="prefix x_reflect y_reflect">
    <link name="${prefix}_wheel">
      <visual>
        <geometry><cylinder radius="0.03" length="0.03"/></geometry>
        <material name="wheel_mat"/>
      </visual>
      <collision>
        <geometry><cylinder radius="0.03" length="0.03"/></geometry>
      </collision>
      <inertial>
        <mass value="0.15"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.000045" ixy="0" ixz="0" iyy="0.000045" iyz="0" izz="0.0000675"/>
      </inertial>
    </link>
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel"/>
      <origin xyz="${x_reflect * 0.075} ${y_reflect * 0.0825} 0" rpy="-1.5708 0 0"/>
      <axis xyz="0 0 1"/>
    </joint>
  </xacro:macro>

  <xacro:wheel prefix="front_left" x_reflect="1" y_reflect="1"/>
  <xacro:wheel prefix="front_right" x_reflect="1" y_reflect="-1"/>
  <xacro:wheel prefix="rear_left" x_reflect="-1" y_reflect="1"/>
  <xacro:wheel prefix="rear_right" x_reflect="-1" y_reflect="-1"/>

  <gazebo reference="front_left_wheel"><mu1>1.0</mu1><mu2>0.0</mu2><fdir1>1 1 0</fdir1></gazebo>
  <gazebo reference="front_right_wheel"><mu1>1.0</mu1><mu2>0.0</mu2><fdir1>1 -1 0</fdir1></gazebo>
  <gazebo reference="rear_left_wheel"><mu1>1.0</mu1><mu2>0.0</mu2><fdir1>1 -1 0</fdir1></gazebo>
  <gazebo reference="rear_right_wheel"><mu1>1.0</mu1><mu2>0.0</mu2><fdir1>1 1 0</fdir1></gazebo>

  <gazebo>
    <plugin filename="gz-sim-mecanum-drive-system" name="gz::sim::systems::MecanumDrive">
      <front_left_joint>front_left_wheel_joint</front_left_joint>
      <front_right_joint>front_right_wheel_joint</front_right_joint>
      <back_left_joint>rear_left_wheel_joint</back_left_joint>
      <back_right_joint>rear_right_wheel_joint</back_right_joint>
      <wheel_separation>0.165</wheel_separation>
      <wheelbase>0.15</wheelbase>
      <wheel_radius>0.03</wheel_radius>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
    </plugin>
  </gazebo>

  <!-- Publish real simulated wheel angles for robot_state_publisher/RViz. -->
  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <joint_name>front_left_wheel_joint</joint_name>
      <joint_name>front_right_wheel_joint</joint_name>
      <joint_name>rear_left_wheel_joint</joint_name>
      <joint_name>rear_right_wheel_joint</joint_name>
      <topic>/joint_states</topic>
      <update_rate>50</update_rate>
    </plugin>
  </gazebo>
</robot>
