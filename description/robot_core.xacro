<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="inertial_macros.xacro" />

  <xacro:property name="chassis_length" value="0.40" />
  <xacro:property name="chassis_width" value="0.30" />
  <xacro:property name="chassis_thickness" value="0.05" />
  <xacro:property name="wheel_radius" value="0.0485" />
  <xacro:property name="wheel_width" value="0.045" />
  <xacro:property name="wheel_x" value="0.15" />
  <xacro:property name="wheel_y" value="0.1925" />

  <material name="dark_grey"><color rgba="0.1 0.1 0.1 1" /></material>
  <material name="blue"><color rgba="0.1 0.3 0.9 1" /></material>

  <link name="base_link" />

  <joint name="chassis_joint" type="fixed">
    <parent link="base_link" />
    <child link="chassis" />
    <origin xyz="0 0 ${wheel_radius}" />
  </joint>

  <link name="chassis">
    <visual>
      <origin xyz="0 0 0" />
      <geometry><box size="${chassis_length} ${chassis_width} ${chassis_thickness}" /></geometry>
      <material name="dark_grey" />
    </visual>
    <collision>
      <origin xyz="0 0 0" />
      <geometry><box size="${chassis_length} ${chassis_width} ${chassis_thickness}" /></geometry>
    </collision>
    <xacro:inertial_box mass="2.0" x="${chassis_length}" y="${chassis_width}" z="${chassis_thickness}" />
  </link>

  <gazebo reference="chassis">
    <material>Gazebo/DarkGrey</material>
  </gazebo>

  <xacro:macro name="mecanum_wheel" params="name x y">
    <joint name="${name}_wheel_joint" type="continuous">
      <parent link="base_link" />
      <child link="${name}_wheel" />
      <origin xyz="${x} ${y} ${wheel_radius}" />
      <axis xyz="0 1 0" />
      <dynamics damping="0.01" friction="0.01"/>
    </joint>

    <link name="${name}_wheel">
      <visual>
        <origin rpy="${pi / 2.0} 0 0" />
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}" /></geometry>
        <material name="blue" />
      </visual>
      <collision>
        <origin rpy="${pi / 2.0} 0 0" />
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}" /></geometry>
      </collision>
      <xacro:inertial_cylinder mass="0.2" length="${wheel_width}" radius="${wheel_radius}" />
    </link>

    <gazebo reference="${name}_wheel">
      <material>Gazebo/Blue</material>
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
      <kp>1e6</kp>
      <kd>1.0</kd>
    </gazebo>
  </xacro:macro>

  <xacro:mecanum_wheel name="front_left" x="${wheel_x}" y="${wheel_y}" />
  <xacro:mecanum_wheel name="front_right" x="${wheel_x}" y="-${wheel_y}" />
  <xacro:mecanum_wheel name="rear_left" x="-${wheel_x}" y="${wheel_y}" />
  <xacro:mecanum_wheel name="rear_right" x="-${wheel_x}" y="-${wheel_y}" />
</robot>
